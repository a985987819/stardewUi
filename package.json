{
  "name": "stardew-valley-ui",
  "version": "0.1.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "description": "A Stardew Valley-inspired pixel-art React component library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a985987819/stardewUi.git"
  },
  "bugs": {
    "url": "https://github.com/a985987819/stardewUi/issues"
  },
  "homepage": "https://github.com/a985987819/stardewUi#readme",
  "keywords": [
    "react",
    "stardew-valley",
    "pixel-art",
    "ui-components",
    "component-library"
  ],
  "license": "MIT",
  "main": "./dist/stardew-valley-ui.cjs",
  "module": "./dist/stardew-valley-ui.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/stardew-valley-ui.mjs",
      "require": "./dist/stardew-valley-ui.cjs"
    },
    "./style.css": "./dist/stardew-valley-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx tsc -b && bun run check:components && bunx vite build && node scripts/prepare-github-pages.mjs",
    "build:app": "bunx tsc -b && bun run check:components && bunx vite build",
    "build:lib": "bunx vite build --mode lib && bunx tsc -p tsconfig.lib.json",
    "verify:package": "node scripts/verify-package.mjs",
    "gen:component": "bun scripts/new-component.mjs",
    "rm:component": "bun scripts/rm-component.mjs",
    "check:components": "bunx vitest run src/router/componentRegistry.sync.test.tsx",
    "lint": "bunx eslint .",
    "preview": "bunx vite preview",
    "test": "bunx vitest",
    "test:run": "bunx vitest run",
    "test:coverage": "bunx vitest run --coverage",
    "test:smoke": "bun scripts/smoke-routes.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.17",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.0.2",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "lucide-react": "^1.9.0",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "sass": "^1.99.0",
    "tailwindcss": "3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
